# AppArmor profiles for the TM-C3500 CUPS filter and backend.
#
# Shipped in COMPLAIN mode: violations are logged, nothing is blocked. After printing, cutting, a
# held job and an alert have all been exercised on the target host, check the log with
#   journalctl -k | grep -E 'apparmor=.*tmc3500'
# and, if clean, enforce with:  aa-enforce /etc/apparmor.d/tmc3500
# Note: a confined cupsd (Ubuntu's usr.sbin.cupsd profile) may run third-party backends in its own
# child profile instead of this one; see docs/operations.md.

abi <abi/3.0>,
include <tunables/global>

profile tmc3500-filter /usr/lib/cups/filter/rastertotmc3500 flags=(complain) {
  include <abstractions/base>

  /usr/lib/cups/filter/rastertotmc3500 mr,
  /etc/cups/ppd/*.ppd r,
  /usr/share/ppd/tmc3500/* r,
  /usr/share/tmc3500/colour/ r,
  /usr/share/tmc3500/colour/* r,
  /etc/machine-id r,
  # CUPS passes the job on stdin/stdout or as a spool file
  /var/spool/cups/** r,
  /{,var/}tmp/** r,
  deny network,
}

profile tmc3500-backend /usr/lib/cups/backend/tmc3500 flags=(complain) {
  include <abstractions/base>
  include <abstractions/nameservice>

  /usr/lib/cups/backend/tmc3500 mr,
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,

  /etc/tmc3500/ r,
  /etc/tmc3500/** r,
  /var/lib/tmc3500/ rwk,
  /var/lib/tmc3500/** rwk,
  /var/spool/cups/** r,
  @{PROC}/net/tcp r,
  @{PROC}/net/tcp6 r,
  @{PROC}/@{pid}/net/tcp r,
  @{PROC}/@{pid}/net/tcp6 r,
  /dev/urandom r,
  /usr/bin/kill ix,
  # alert hooks are administrator-owned scripts (ownership is checked by the backend); they need
  # mail, curl, logger etc., so they run unconfined
  /etc/tmc3500/alert.d/* Ux,
  signal (receive) set=(term, kill) peer=unconfined,
}
